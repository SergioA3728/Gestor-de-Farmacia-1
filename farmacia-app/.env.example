# URL de conexión a PostgreSQL.
# En local: crea la BD en PostgreSQL y pega aquí tu URL.
# En Render: se inyecta automáticamente al crear la base de datos PostgreSQL.
#
# Formato:
#   postgresql://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD
#
# Ejemplo local:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmacia
#
# Ejemplo Render (lo llena Render solo, no lo copies):
#   DATABASE_URL=postgresql://farmacia_user:xxxxx@dpg-xxxxx/farmacia
DATABASE_URL=

# ── Login (ver docs/planes/2026-11-16-login-roles.md) ──
# Clave para firmar las cookies de sesión. OBLIGATORIA: sin ella la app no arranca.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
# Usa una distinta en local y en Render, y nunca la subas a Git.
SECRET_KEY=

# Primer administrador. Solo se usa si la tabla `usuarios` está vacía.
# La contraseña debe tener al menos 8 caracteres. En Render puedes borrarla
# del panel después del primer arranque.
ADMIN_USUARIO=
ADMIN_PASSWORD=

# 1 = la cookie solo viaja por HTTPS (Render). En local no hay HTTPS: usa 0.
COOKIE_SEGURA=0
