# URL de conexión a PostgreSQL.
# En local: crea la BD en PostgreSQL y pega aquí tu URL.
# En Render: se inyecta automáticamente al crear la base de datos PostgreSQL.
#
# Formato:
#   postgresql://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD
#
# Ejemplo local:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmacia
#
# Ejemplo Render (lo llena Render solo, no lo copies):
#   DATABASE_URL=postgresql://farmacia_user:xxxxx@dpg-xxxxx/farmacia
DATABASE_URL=
